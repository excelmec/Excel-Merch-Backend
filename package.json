{
  "name": "excel-merch-backend",
  "version": "1.0.0",
  "description": "Excel Merchandise backend",
  "main": "index.js",
  "scripts": {
    "generate": "prisma generate --schema=./src/prisma/schema.prisma",
    "migrate:dev": "prisma migrate dev --schema=./src/prisma/schema.prisma",
    "dev": "npm run generate && nodemon src/index.ts",
    "prebuild": "npm run generate",
    "build": "tsc",
    "postbuild": "copyfiles --flat ./src/utils/mailTemplates/*.html ./dist/utils/mailTemplates",
    "migrate:deploy": "prisma migrate deploy --schema=./src/prisma/schema.prisma",
    "prestart": "npm run generate && npm run migrate:deploy",
    "start": "node dist/index.js",
    "cron": "node dist/cronRunner.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/copyfiles": "^2.4.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/localtunnel": "^2.0.4",
    "@types/lodash": "^4.17.20",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/mustache": "^4.2.6",
    "@types/node": "^24.2.1",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.16.0",
    "@prisma/client": "^6.14.0",
    "bcrypt": "^6.0.0",
    "copyfiles": "^2.4.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-jwt": "^8.5.1",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "localtunnel": "^2.0.2",
    "lodash": "^4.17.21",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "mustache": "^4.2.0",
    "nodemailer": "^7.0.5",
    "nodemon": "^3.1.10",
    "razorpay": "^2.9.6",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "winston-transport": "^4.9.0"
  }
}
